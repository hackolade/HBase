{
    "name": "HBase",
    "version": "0.2.6",
    "author": "hackolade",
    "engines": {
        "hackolade": "2.3.2",
        "hackoladePlugin": "1.0.0"
    },
    "contributes": {
        "target": {
            "applicationTarget": "HBase",
            "title": "HBase",
            "versions": [
                "1.1.x",
                "1.2.x",
                "1.3.x",
                "2.0.x"
            ]
        },
        "features": {
            "nestedCollections": false,
            "jaySchemaHasRequiredPatternField": true,
            "enableReverseEngineering": true,
            "enableForwardEngineering": true
        }
    },
    "description": "Hackolade plugin for Apache HBase",
    "scripts": {
        "lint": "oxlint . || true",
        "package": "node esbuild.package.js",
        "postinstall": "npx simple-git-hooks",
        "lint:check": "oxlint --type-aware --type-check . || true",
        "format": "prettier --write ."
    },
    "dependencies": {
        "async": "^3.2.4",
        "node-fetch": "2.7.0"
    },
    "devDependencies": {
        "@hackolade/hck-esbuild-plugins-pack": "0.0.1",
        "@ianvs/prettier-plugin-sort-imports": "4.7.1",
        "esbuild": "0.28.1",
        "esbuild-node-externals": "1.23.1",
        "esbuild-plugin-clean": "1.0.1",
        "lint-staged": "^17.0.7",
        "oxlint": "^1.70.0",
        "oxlint-tsgolint": "^0.23.0",
        "prettier": "^3.8.4",
        "simple-git-hooks": "^2.13.1"
    },
    "simple-git-hooks": {
        "pre-commit": "npm run package && npx lint-staged --config lint-staged.config.js",
        "pre-push": "npm run lint"
    },
    "overrides": {
        "minimatch": "10.2.4",
        "brace-expansion": "5.0.8"
    }
}
