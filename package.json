{
    "name": "HBase",
    "version": "0.2.5",
    "author": "hackolade",
    "engines": {
        "hackolade": "2.3.2",
        "hackoladePlugin": "1.0.0"
    },
    "contributes": {
        "target": {
            "applicationTarget": "HBase",
            "title": "HBase",
            "versions": [
                "1.1.x",
                "1.2.x",
                "1.3.x",
                "2.0.x"
            ]
        },
        "features": {
            "nestedCollections": false,
            "jaySchemaHasRequiredPatternField": true,
            "enableReverseEngineering": true,
            "enableForwardEngineering": true
        }
    },
    "description": "Hackolade plugin for Apache HBase",
    "scripts": {
        "lint": "oxlint . || true",
        "package": "node esbuild.package.js",
        "postinstall": "npx simple-git-hooks",
        "lint:check": "oxlint --type-aware --type-check . || true"
    },
    "dependencies": {
        "async": "^3.2.4",
        "node-fetch": "2.7.0"
    },
    "devDependencies": {
        "@hackolade/hck-esbuild-plugins-pack": "0.0.1",
        "esbuild": "0.27.3",
        "esbuild-node-externals": "1.20.1",
        "esbuild-plugin-clean": "1.0.1",
        "lint-staged": "16.2.7",
        "prettier": "3.8.1",
        "simple-git-hooks": "2.13.1",
        "oxlint": "1.38.0",
        "oxlint-tsgolint": "0.10.1"
    },
    "lint-staged": {
        "*.{js,json}": "prettier --write"
    },
    "simple-git-hooks": {
        "pre-commit": "npm run package && npx lint-staged",
        "pre-push": "npm run lint"
    },
    "overrides": {
        "minimatch": "10.2.1"
    }
}
